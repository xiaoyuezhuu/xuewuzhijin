# --- Which model writes the curation ------------------------------------
# LLM_PROVIDER is "meta" (default) or "anthropic". Run `npm run llm:check`
# after editing — it makes one tiny call per pass and reports what broke.
LLM_PROVIDER=meta

# Meta Model API (https://api.meta.ai/v1). Required when LLM_PROVIDER=meta.
MODEL_API_KEY=

# Optional per-pass overrides. Triage is the big mechanical scoring pass and
# selection carries the judgement, so they can run on different models — e.g.
# TRIAGE_MODEL=muse-spark-1.3 with SELECT_MODEL=claude-opus-5 is not supported
# (one provider at a time), but swapping either within a provider is.
# TRIAGE_MODEL=muse-spark-1.3
# SELECT_MODEL=muse-spark-1.3

# Only when LLM_PROVIDER=anthropic. Without it, `npm run curate:dry` still
# works (heuristic ranking, no written notes).
ANTHROPIC_API_KEY=

# Only needed if the key above is an ORGANIZATION key rather than a
# workspace-scoped one. An unscoped key must name a workspace on every
# request, and the API rejects it with a 400 otherwise. Find the ID in the
# Anthropic Console under Settings → Workspaces (it looks like wrkspc_...),
# or just create a workspace-scoped key and leave this blank.
ANTHROPIC_WORKSPACE_ID=

# Optional. Each adapter is skipped with a warning when its credentials are absent.

# Reddit: create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Any descriptive string; Reddit rejects generic/library user-agents.
REDDIT_USER_AGENT=xuewuzhijin/0.1 by u/yourusername

# X/Twitter: requires an X API plan with recent-search access (Basic tier and up)
X_BEARER_TOKEN=

# Deployment
SITE_URL=https://example.com
BASE_PATH=/
