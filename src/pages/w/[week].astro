---
import Base from "../../layouts/Base.astro";
import Edition from "../../components/Edition.astro";
import { weeklies, previousBarometer } from "../../lib/data";
import type { Curation } from "../../lib/data";

export function getStaticPaths() {
  return weeklies.map((curation) => ({
    params: { week: curation.slug },
    props: { curation },
  }));
}

const { curation } = Astro.props as { curation: Curation };
---

<Base title={`學無止盡 · best of ${curation.slug}`} edition="weekly" nav="week">
  <Edition curation={curation} previousBarometer={previousBarometer(curation.slug, "weekly")} />
</Base>
